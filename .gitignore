# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Medical Datasets & Neuroimaging Raw Data (HIPAA / Privacy & Size) ---
data/
ISLES-2022/
*.nii
*.nii.gz
*.mha
*.mhd
*.raw
*.dcm
*.dicom
*.xlsx
*.xls
*.npz

# --- Large Model Checkpoints & Serialized Weights (> 50MB) ---
outputs/checkpoints/
outputs/**/checkpoints/
*.pth
*.pt
*.ckpt
*.h5
*.bin
*.onnx

# --- Logs & Ephemeral Files ---
*.log
outputs/logs/*.log
outputs/**/*.log
outputs/logs/inspection_report.json
outputs/logs/neonatal_inspection_report.json
outputs/logs/inspection_summary.txt
outputs/logs/neonatal_inspection_summary.txt

# --- IDE & OS Cache ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Jupyter & Matplotlib Caches ---
.ipynb_checkpoints
